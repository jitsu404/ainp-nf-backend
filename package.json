{
  "name": "icar-nf-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for the AINP-Natural Farming Project Management System (ICAR-IIFSR)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "lint": "eslint .",
    "seed": "tsx src/scripts/seed.ts",
    "postman": "tsx src/scripts/generate-postman.ts",
    "migrate:user-fields": "tsx src/scripts/migrate-user-fields.ts",
    "migrate:pi-seats": "tsx src/scripts/migrate-pi-seats.ts",
    "migrate:generated-codes": "tsx src/scripts/migrate-generated-codes.ts",
    "format": "prettier --write .",
    "prepare": "husky",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": "prettier --write"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jstat": "^1.9.6",
    "moment": "^2.30.1",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
