NODE_ENV=development
PORT=5000
# Transactions need a replica set, even locally (append ?replicaSet=rs0 for a local single-node set).
MONGODB_URI=mongodb://127.0.0.1:27017/ainp-nf?replicaSet=rs0
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5174
# Optional: how many proxies sit in front of the API (their X-Forwarded-For is trusted, so rate
# limits and audit IPs see the user's address). Render alone: 1. Client on Vercel forwarding /api
# to Render: 2. Default: 1 in production, 0 otherwise.
# TRUST_PROXY=2
# Optional: error | warn | info | http | debug
LOG_LEVEL=debug
# Used only by `npm run seed` to create the first Super Administrator (min 10 chars, a letter and a digit).
SEED_SUPERADMIN_EMAIL=superadmin@ainp-nf.local
SEED_SUPERADMIN_PASSWORD=change-me-123
